# One deployment runs one tournament. Copy this to .env (npm run setup:devnet does it for you).

# --- the tournament ---------------------------------------------------------------------------
TOURNAMENT_NAME=Smash Cup (example)
# ISO times. Entries open at the start; at the end, matches in play get SETTLE_GRACE_MINUTES to finish.
TOURNAMENT_STARTS=2026-10-05T12:00:00Z
TOURNAMENT_ENDS=2026-10-05T18:00:00Z
# 0 = most wins when time runs out. N > 0 = the first player to N wins takes it, and it ends right then.
WIN_TARGET=0
# mutators (the default game) or classic
RULESET=mutators

# --- money --------------------------------------------------------------------------------------
# What one match costs to enter, in whole tokens. All of it goes into the prize pool.
MATCH_FEE=10
# The organizer's cut at settlement, in percent. 0 = the winner takes it all.
RAKE_PERCENT=0

# --- fair play ----------------------------------------------------------------------------------
# The most times two players can be paired (blunts win-trading between friends).
MAX_REPEAT_PAIRINGS=2
# The fewest different opponents the winner must have played.
MIN_OPPONENTS_TO_WIN=2
# 1 = a no-show or a stall is a win for the other player. 0 = it counts for nothing (and whoever
# showed up goes back in the queue for free).
FORFEITS_COUNT=1
SHOW_UP_MINUTES=5
MOVE_TIMEOUT_MINUTES=5
SETTLE_GRACE_MINUTES=20
# person = players agree to play themselves (a seat that says an agent plays it forfeits).
# any = AI agents are welcome too.
PLAYER_KIND=person
# The minimum age to enter, which you must state and enforce (Smash&Clash Terms, section 14A): 18, or higher
# where the law where you or your players are requires it. On mainnet, players confirm it before their first
# paid entry; set AGE_CHECK=1 to ask on devnet too.
MIN_AGE=18

# --- where it may run ---------------------------------------------------------------------------
# Countries (ISO codes) that may not enter. Real-money contests are restricted in many places:
# check the law where you and your players are, and add to this list. Your host or CDN must set
# COUNTRY_HEADER (Vercel and Cloudflare do: x-vercel-ip-country / cf-ipcountry).
BLOCKED_REGIONS=IN
COUNTRY_HEADER=x-vercel-ip-country

# --- Solana -------------------------------------------------------------------------------------
# devnet (free test tokens) until you have read docs/going-to-mainnet.md
SOLANA_CLUSTER=devnet
# SOLANA_RPC=https://api.devnet.solana.com
# The RPC players' browsers use; a public one is fine on devnet. Use your own provider on mainnet.
# SOLANA_PUBLIC_RPC=
# Set by npm run setup:devnet. On mainnet it defaults to $SMASH: 4VkfpAfHWFkBsVoSrAp4bos4yzWmJYj3z1LPNm1Dxory
SMASH_MINT=
POOL_KEYPAIR=./keys/pool.json
# devnet only: a "get test tokens" button for testers
DEV_FAUCET=1

# --- the server ---------------------------------------------------------------------------------
PORT=8787
PUBLIC_URL=http://localhost:8787
DATA_DIR=./data
SMASH_API=https://www.smashandclash.in

# --- the showcase -------------------------------------------------------------------------------
# Your name, shown as the organizer. Optional.
ORGANIZER_NAME=
# A look (night, candy, sunset, forest, mono; empty = the default blue) and your platform's name in place of
# the logo. Preview any look in the browser with ?theme=night&brand=My%20League
THEME=
BRAND_NAME=
# Other tournaments to show beside this one: URLs of other deployments of this example, comma-separated.
PEER_TOURNAMENTS=
