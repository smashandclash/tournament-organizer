{
  "name": "smashandclash-tournaments",
  "version": "1.0.0",
  "private": true,
  "description": "A $SMASH prize-pool tournament for Smash&Clash, built with the Smash&Clash SDK: an example to fork and run on your own platform.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.smashandclash.in",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup:devnet": "node --env-file-if-exists=.env scripts/setup-devnet.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "settle": "node --env-file-if-exists=.env scripts/settle.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.mjs"
  },
  "dependencies": {
    "@smashandclash/sdk": "^0.2.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  }
}
